{
  "actorSpecification": 1,
  "name": "opility-b2b-lead-generator",
  "title": "🚀 B2B Leads Scraper ✅ $1.5/1k Leads ✅ Emails & Phones",
  "description": "$1.5/1k Leads — Scrape B2B leads with verified decision-maker Emails, Phone Numbers, & Socials across Google Maps & Directories. High-speed alternative to Apollo, ZoomInfo, & Lusha!",
  "version": "1.0.0",
  "meta": {
    "templateId": "project_cheerio_crawler_javascript"
  },
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "B2B Leads Dataset",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "title",
              "category",
              "phone",
              "email",
              "website",
              "address",
              "rating",
              "reviewsCount",
              "socialLinks"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": { "label": "Company Name" },
              "category": { "label": "Category" },
              "phone": { "label": "Phone Number" },
              "email": { "label": "Email Address" },
              "website": { "label": "Website" },
              "address": { "label": "Address" },
              "rating": { "label": "Rating" },
              "reviewsCount": { "label": "Reviews" }
            }
          }
        }
      }
    }
  }
}
