{
  "actorSpecification": 1,
  "name": "opility-b2b-lead-generator",
  "title": "B2B Lead Generator & Email Extractor (Directories & Maps)",
  "description": "Automated B2B lead scraping & contact extraction engine. Scrapes company listings, Google Maps & directories across target locations and extracts decision-maker emails, phone numbers, and social media links.",
  "version": "1.0.0",
  "meta": {
    "templateId": "project_cheerio_crawler_javascript"
  },
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "B2B Lead Generator Output Schema",
    "description": "Output schema defining the dataset containing extracted company leads, phone numbers, verified emails, and social profiles.",
    "properties": {
      "dataset": {
        "type": "string",
        "title": "Dataset",
        "description": "Default dataset containing extracted B2B leads",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "B2B Leads Dataset",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "title",
              "category",
              "phone",
              "email",
              "website",
              "address",
              "rating",
              "reviewsCount",
              "socialLinks"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": { "label": "Company Name" },
              "category": { "label": "Category" },
              "phone": { "label": "Phone Number" },
              "email": { "label": "Email Address" },
              "website": { "label": "Website" },
              "address": { "label": "Address" },
              "rating": { "label": "Rating" },
              "reviewsCount": { "label": "Reviews" }
            }
          }
        }
      }
    }
  }
}
